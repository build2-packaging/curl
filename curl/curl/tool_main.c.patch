+/*
+ * Set the SSL_CERT_FILE environment variable to refer to the bundled CA
+ * certificates, unless it is already set, and switch to the OpenSSL backend.
+ * Must be called before the curl library is initialized.
+ */
+static CURLcode ca_certificates_init(void)
+{
+  char* env = curl_getenv ("SSL_CERT_FILE");
+
+  if (env == NULL)
+  {
+    int r;
+
+#ifndef _WIN32
+    r = setenv ("SSL_CERT_FILE", ca_certificates_file (), 0 /* overwrite */);
+#else
+    char* v = curl_maprintf ("SSL_CERT_FILE=%s", ca_certificates_file ());
+
+    if (v != NULL)
+    {
+      r = _putenv (v);
+      curl_free (v);
+    }
+    else
+      r = -1;
+#endif
+
+    if (r == -1)
+      return CURLE_FAILED_INIT;
+  }
+  else
+    curl_free (env);
+
+  if (curl_global_sslset (CURLSSLBACKEND_OPENSSL,
+                          NULL /* name */,
+                          NULL /* avail */) != CURLSSLSET_OK)
+    return CURLE_FAILED_INIT;
+
+  return CURLE_OK;
+}
+
 /*
  * curl tool main function.
  */
